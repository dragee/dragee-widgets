{
  "name": "dragee-widgets",
  "version": "0.3.0",
  "description": "Widgets Based on Dragee Library",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "build-dev": "rollup --config rollup.dev.config.mjs",
    "eslint": "eslint .",
    "prepublishOnly": "npm run eslint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragee/dragee-widgets.git"
  },
  "author": "Vitaliy Yarovuy, Volodymyr Myskov",
  "license": "ISC",
  "main": "dist/index.umd.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.esm.js",
    "dist/index.min.js",
    "dist/index.umd.js"
  ],
  "homepage": "https://dragee.github.io/",
  "bugs": "https://github.com/dragee/dragee-widgets/issues",
  "keywords": [
    "dragee",
    "drag&drop",
    "chart-slider",
    "arc-slider"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "dragee": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "dragee": "^2.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "rollup": "^4.63.5"
  }
}
